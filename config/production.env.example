RAILS_ENV=production
RAILS_MAX_THREADS=2
WEB_CONCURRENCY=1
LEFTY_WEFTY_PUBLIC_ORIGIN=https://lefty-wefty.devs.surf
LEFTY_WEFTY_PUBLIC_INDEXING=false
# Set this only to the actual provider-assigned preview hostname.
LEFTY_WEFTY_PREVIEW_HOST=

# Generate a unique secret and configure it through the hosting provider's UI.
SECRET_KEY_BASE=
# Use separate service credentials for the same fresh database.
DATABASE_URL=postgresql://RUNTIME_ROLE:URL_ENCODED_PASSWORD@DIRECT_DATABASE_HOST/NEW_DATABASE?sslmode=verify-full
MIGRATION_DATABASE_URL=postgresql://MIGRATION_ROLE:URL_ENCODED_PASSWORD@DIRECT_DATABASE_HOST/NEW_DATABASE?sslmode=verify-full
LEFTY_WEFTY_DB_SSLROOTCERT=system

# Create a private bucket; copy its real endpoint and region from the provider.
LEFTY_WEFTY_STORAGE_SERVICE=s3
LEFTY_WEFTY_S3_ENDPOINT=https://YOUR_BRANCH_S3_ENDPOINT
LEFTY_WEFTY_S3_REGION=us-east-2
LEFTY_WEFTY_S3_BUCKET=YOUR_PRIVATE_BUCKET
LEFTY_WEFTY_S3_ACCESS_KEY_ID=
LEFTY_WEFTY_S3_SECRET_ACCESS_KEY=

# Password reset is unavailable in this deployment. Leave mail credentials unset.
LEFTY_WEFTY_BREVO_ENABLED=false
BREVO_API_KEY=
LEFTY_WEFTY_MAIL_FROM=
