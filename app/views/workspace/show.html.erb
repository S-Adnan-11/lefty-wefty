<% content_for :title, "Overview | Lefty-Wefty" %>
<div class="page-heading">
  <div><h1>Overview</h1><p class="muted">Stock at a glance · <%= Current.business.currency %> · <%= Current.business.timezone %></p></div>
  <div class="actions"><%= link_to "Record sale", new_order_path, class: "button button-primary" %><%= link_to "Add product", new_product_path, class: "button button-primary" %></div>
</div>
<div class="metrics overview-metrics">
  <section class="card month-summary">
    <span><%= @month_sales.current_month.strftime("%B %Y") %> · month to date</span>
    <strong id="month-sales-value" class="price"><%= money_minor(@month_sales.total_minor) %></strong>
    <p><span id="month-sale-count"><%= number_with_delimiter(@month_sales.sale_count) %></span> completed sales · <%= link_to "Monthly report", report_path %></p>
  </section>
  <div class="card"><span>Active products</span><strong><%= @active_count %></strong></div>
  <div class="card"><span>Units in active stock</span><strong><%= number_with_delimiter(@total_units) %></strong></div>
  <div class="card"><span>Low-stock products</span><strong><%= @low_stock_count %></strong></div>
</div>
<div class="workspace-grid overview-grid">
  <section class="card">
    <div class="section-heading"><h2>Recent sales</h2><%= link_to "All sales", orders_path %></div>
    <% if @recent_sales.empty? %><p class="empty">No recorded sales yet. <%= link_to "Create a draft", new_order_path %> to review products and prices.</p><% else %>
      <ul class="record-list"><% @recent_sales.each do |order| %><li><div><%= link_to "Sale ##{order.id}", order %><small><%= sale_status(order.state) %> · <%= local_time(order.voided_at || order.confirmed_at) %></small></div><strong><%= money_minor(order.total_minor) %></strong></li><% end %></ul>
    <% end %>
  </section>
  <section class="card">
    <div class="section-heading"><h2>Needs a closer look</h2><%= link_to "All low stock", products_path(status: "low") %></div>
    <p class="muted">Active products at or below their low-stock reminder, including zero.</p>
    <% if @low_stock.empty? %>
      <p class="empty">No products need restocking. <%= link_to "Browse products", products_path %> or add your first product.</p>
    <% else %>
      <ul class="record-list"><% @low_stock.each do |product| %><li><div><%= link_to product.name, product %><small><%= product.sku %></small></div><span class="badge warning"><%= product.quantity %> left</span><%= link_to product_path(product, anchor: "stock-change"), class: "stock-shortcut" do %>Add stock<span class="sr-only"> for <%= product.name %></span><% end %></li><% end %></ul>
    <% end %>
  </section>
  <section class="card recent-stock">
    <div class="section-heading"><h2>Recent stock changes</h2><%= link_to "All stock history", stock_movements_path %></div>
    <% if @recent_movements.empty? %>
      <p class="empty">Your stock history starts with your first receipt or adjustment.</p>
    <% else %>
      <ul class="record-list"><% @recent_movements.each do |movement| %><li><div><%= link_to movement.product.name, movement.product %><small><%= movement_label(movement.kind) %> · <%= local_time(movement.created_at) %></small><% if movement.order_item %><%= link_to "Sale ##{movement.order_item.order_id}", order_path(movement.order_item.order_id) %><% if movement.reversal_of_id %><small>Reverses movement #<%= movement.reversal_of_id %></small><% end %><% end %></div><strong><%= signed_units(movement.quantity_delta) %></strong></li><% end %></ul>
    <% end %>
  </section>
</div>
