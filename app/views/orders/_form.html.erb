<div class="card form-card">
  <p>Saving a draft does not reserve or deduct stock. Review the server's prices and total before confirming. Leave unused lines empty; clear both fields to remove a line.</p>
  <% if @error %><div class="errors" role="alert"><%= @error %></div><% end %>
  <% if @products.empty? %><p>No active products are available. <%= link_to "Add a product", new_product_path %> before saving a sale.</p><% end %>
  <%= form_with url: @order ? order_path(@order) : orders_path, method: @order ? :patch : :post, class: "stack", data: { pending: true } do %>
    <% if @order %><%= hidden_field_tag "order[revision]", @revision %><% else %><%= hidden_field_tag "order[submission_key]", @submission_key %><% end %>
    <div id="sale-lines"><% @lines.each_with_index do |line, index| %><%= render "line", line: line, index: index %><% end %></div>
    <template id="sale-line-template"><%= render "line", line: {}, index: "__INDEX__" %></template>
    <button type="button" class="button-secondary" id="add-sale-line" hidden>Add product line</button>
    <%= submit_tag "Save draft for review" %>
    <p class="muted" role="status" data-submission-status></p>
  <% end %>
</div>
