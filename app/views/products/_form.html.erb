<%= render "shared/errors", object: @product %>
<%= form_with model: @product, class: "stack" do |form| %>
  <div><%= form.label :name, "Product name" %><%= form.text_field :name, required: true, maxlength: 160 %></div>
  <div><div class="field-heading"><%= form.label :sku, "Product code (optional)" %><%= render "shared/help", label: "Product code", text: "Your shop’s short identifier, such as RICE-5KG. SKU stands for Stock Keeping Unit. Use letters, numbers, dots, hyphens or underscores. Codes are stored in uppercase and must be unique in your business." %></div><%= form.text_field :sku, maxlength: 64, aria: { describedby: "sku-help" } %><small id="sku-help"><%= @product.new_record? ? "Leave blank and we’ll create a code for you." : "Leave blank to keep the current code." %></small></div>
  <div><%= form.label :price_naira, "Selling price" %><div class="money-input"><span aria-hidden="true">₦</span><%= form.text_field :price_naira, required: true, inputmode: "decimal", data: { money: true }, aria: { label: "Selling price in naira", describedby: "price-help" } %></div><small id="price-help">For example, 1,250.50</small></div>
  <div><div class="field-heading"><%= form.label :low_stock_threshold, "Low-stock reminder" %><%= render "shared/help", label: "Low-stock reminder", text: "We’ll highlight this product when the remaining stock reaches this number or lower. This is a reminder inside the app." %></div><%= render "shared/quantity", name: "product[low_stock_threshold]", id: "product_low_stock_threshold", value: @product.low_stock_threshold_before_type_cast, min: 0, label: "Low-stock reminder" %></div>
  <% if @product.new_record? %>
    <div><div class="field-heading"><%= label_tag :opening_quantity, "Starting stock" %><%= render "shared/help", label: "Starting stock", text: "How many units are on your shelf now? We record this as the first entry in your stock history. Use zero to start empty." %></div><%= render "shared/quantity", name: "opening_quantity", id: "opening_quantity", value: @opening_quantity, min: 0, label: "Starting stock" %></div>
  <% end %>
  <div class="actions"><%= form.submit @product.new_record? ? "Create product" : "Save product" %><%= link_to "Cancel", @product.persisted? ? product_path(@product) : products_path %></div>
<% end %>
