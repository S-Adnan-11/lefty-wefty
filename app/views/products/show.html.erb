<% content_for :title, "#{@product.name} · Lefty-Wefty" %>
<p><%= link_to "← Products", products_path %></p>
<div class="page-heading"><div><p class="eyebrow"><%= @product.sku %></p><h1><%= @product.name %></h1><%= stock_badge(@product) %></div><%= link_to "Edit product", edit_product_path(@product), class: "button button-secondary" %></div>
<div class="metrics">
  <div class="card"><span>Current quantity</span><strong id="quantity"><%= number_with_delimiter(@product.quantity) %></strong></div>
  <div class="card"><span>Selling price</span><strong class="price"><%= money_minor(@product.price_minor) %></strong></div>
  <div class="card"><span>Low-stock threshold</span><strong><%= @product.low_stock_threshold %></strong></div>
</div>
<% if @product.archived? %>
  <div class="card"><h2>Archived product</h2><p>Quantity and movement history are preserved. New stock changes are disabled.</p></div>
<% else %>
  <section class="card form-card stock-form">
    <h2>Record a stock change</h2>
    <p class="muted">Receipts add units. Adjustments add or remove units and require a reason.</p>
    <%= render "shared/errors", object: @change %>
    <%= form_with model: @change, url: product_stock_movements_path(@product), class: "stack" do |form| %>
      <%= form.hidden_field :operation_key %>
      <div><%= form.label :kind, "Movement type" %><%= form.select :kind, [["Receive stock", "receipt"], ["Adjustment", "adjustment"]] %></div>
      <div><%= form.label :quantity, "Quantity change" %><%= form.number_field :quantity, required: true, step: 1, min: -Product::MAX_QUANTITY, max: Product::MAX_QUANTITY, aria: { describedby: "quantity-help" } %><small id="quantity-help">A receipt must be positive. Use a negative adjustment to remove units. Stock cannot fall below zero.</small></div>
      <div><%= form.label :reason, "Reason (required for adjustments)" %><%= form.text_area :reason, maxlength: 500, rows: 2 %></div>
      <%= form.submit "Record stock change" %>
    <% end %>
  </section>
<% end %>
<section class="card">
  <h2>Movement history</h2><p class="muted">Each successful change is permanent. Correct a mistake with a new adjustment. Times are shown in <%= Current.business.timezone %>.</p>
  <% if @movements.empty? %><p class="empty">No movements yet. Receive stock to start the history.</p><% else %>
    <div class="table-scroll" tabindex="0" role="region" aria-label="Movement history table"><table id="movement-history">
      <caption class="sr-only">Stock movements for <%= @product.name %></caption>
      <thead><tr><th scope="col">When</th><th scope="col">Type / reason</th><th scope="col">Change</th><th scope="col">Balance</th><th scope="col">Recorded by</th></tr></thead>
      <tbody><% @movements.each do |movement| %><tr><td><%= local_time(movement.created_at) %></td><td><%= movement.kind.humanize %><small><%= movement.reason %></small></td><td class="numeric"><%= signed_units(movement.quantity_delta) %></td><td class="numeric"><%= movement.resulting_balance %></td><td><%= movement.actor.email_address %></td></tr><% end %></tbody>
    </table></div>
    <%= render "shared/pagination" %>
  <% end %>
</section>
<% unless @product.archived? %>
  <section class="archive-section"><h2>Archive product</h2><p>Remove this product from active lists and low-stock indicators. Stock and history are retained.</p><%= button_to "Archive product", archive_product_path(@product), class: "button-secondary" %></section>
<% end %>
