<% content_for :title, "#{@product.name} · Lefty-Wefty" %>
<p><%= link_to "← Products", products_path %></p>
<div class="page-heading"><div><p class="eyebrow"><%= @product.sku %></p><h1><%= @product.name %></h1><%= stock_badge(@product) %></div><%= link_to "Edit product", edit_product_path(@product), class: "button button-secondary" %></div>
<div class="metrics">
  <div class="card"><span>Current quantity</span><strong id="quantity"><%= number_with_delimiter(@product.quantity) %></strong></div>
  <div class="card"><span>Selling price</span><strong class="price"><%= money_minor(@product.price_minor) %></strong></div>
  <div class="card"><span>Low-stock reminder</span><strong><%= @product.low_stock_threshold %></strong></div>
</div>
<% if @product.archived? %>
  <div class="card"><h2>Archived product</h2><p>Quantity and movement history are preserved. New stock changes are disabled.</p></div>
<% else %>
  <section class="card form-card stock-form">
    <h2>Record a stock change</h2>
    <p class="muted">Receive new stock or correct a count. Corrections need a reason.</p>
    <%= render "shared/errors", object: @change %>
    <%= form_with model: @change, url: product_stock_movements_path(@product), class: "stack" do |form| %>
      <%= form.hidden_field :operation_key %>
      <div><%= form.label :kind, "Stock change" %><%= form.select :kind, [["Receive stock", "receipt"], ["Correct stock", "adjustment"]] %></div>
      <div><%= label_tag "stock_change_direction", "Correction direction" %><%= select_tag "stock_change[direction]", options_for_select([["Add to stock", "add"], ["Remove from stock", "remove"]], @direction || "add"), id: "stock_change_direction", aria: { describedby: "direction-help" } %><small id="direction-help">Applies to corrections. Receiving stock always adds units.</small></div>
      <div><%= form.label :quantity, "Quantity" %><%= render "shared/quantity", name: "stock_change[quantity]", id: "stock_change_quantity", value: @quantity_input || @change.quantity, min: 1, label: "Quantity", describedby: "quantity-help stock_change-errors" %><small id="quantity-help">Enter the number of units. Stock cannot fall below zero.</small></div>
      <div><%= form.label :reason, "Reason (required for corrections)" %><%= form.text_area :reason, maxlength: 500, rows: 2 %></div>
      <%= form.submit "Record stock change" %>
    <% end %>
  </section>
<% end %>
<section class="card">
  <h2>Stock history</h2><p class="muted">Each successful change is permanent. Correct a mistake with a new stock correction. Times are shown in <%= Current.business.timezone %>.</p>
  <% if @movements.empty? %><p class="empty">No stock changes yet. Receive stock to start the history.</p><% else %>
    <div class="table-scroll" tabindex="0" role="region" aria-label="Stock history table"><table id="movement-history">
      <caption class="sr-only">Stock history for <%= @product.name %></caption>
      <thead><tr><th scope="col">When</th><th scope="col">Type / reason</th><th scope="col">Change</th><th scope="col">Balance</th><th scope="col">Recorded by</th></tr></thead>
      <tbody><% @movements.each do |movement| %><tr><td><%= local_time(movement.created_at) %></td><td><%= movement_label(movement.kind) %><small><%= movement_reason(movement) %></small><% if movement.order_item %><%= link_to "Sale ##{movement.order_item.order_id}", order_path(movement.order_item.order_id) %><small>Movement #<%= movement.id %><% if movement.reversal_of_id %> reverses #<%= movement.reversal_of_id %><% end %></small><% end %></td><td class="numeric"><%= signed_units(movement.quantity_delta) %></td><td class="numeric"><%= movement.resulting_balance %></td><td><%= movement.actor.email_address %></td></tr><% end %></tbody>
    </table></div>
    <%= render "shared/pagination" %>
  <% end %>
</section>
<% unless @product.archived? %>
  <section class="archive-section"><h2>Archive product</h2><p>Remove this product from active lists and low-stock indicators. Stock and history are retained.</p><%= button_to "Archive product", archive_product_path(@product), class: "button-secondary" %></section>
<% end %>
