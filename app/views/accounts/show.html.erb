<% content_for :title, "My account · Lefty-Wefty" %>
<div class="page-heading"><div><p class="eyebrow">Your details</p><h1>My account</h1></div></div>
<section class="card form-card"><h2>Login email</h2><p class="account-email"><%= @user.email_address %></p><p class="muted">Use this email to log in.</p></section>
<section class="card form-card"><h2>Change password</h2><p class="muted">Enter your current password. Changing it logs out your other sessions.</p>
  <%= render "shared/errors", object: @user %>
  <%= form_with model: @user, url: account_path, method: :patch, class: "stack" do |form| %>
    <div><%= form.label :current_password, "Current password" %><%= form.password_field :current_password, required: true, autocomplete: "current-password" %></div>
    <div><%= form.label :password, "New password" %><%= form.password_field :password, required: true, minlength: 12, maxlength: 72, autocomplete: "new-password", aria: { describedby: "password-help" } %><small id="password-help">Use 12–72 characters. A long, unique passphrase works well.</small></div>
    <div><%= form.label :password_confirmation, "Confirm new password" %><%= form.password_field :password_confirmation, required: true, autocomplete: "new-password" %></div>
    <%= form.submit "Change password" %>
  <% end %>
</section>
