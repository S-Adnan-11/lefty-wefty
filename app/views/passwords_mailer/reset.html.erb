<h1 style="margin:0 0 16px;font-size:26px;line-height:1.3;color:#203a32;">Reset your password</h1>
<p style="margin:0 0 24px;">Use the button below to choose a new password.</p>
<p style="margin:0 0 24px;"><%= link_to "Reset password", @reset_url, style: "display:inline-block;padding:13px 22px;border-radius:7px;background:#1d4ed8;color:#ffffff;text-decoration:none;font-weight:bold;" %></p>
<p style="margin:0 0 16px;">This link expires in <%= distance_of_time_in_words(0, @user.password_reset_token_expires_in) %>.</p>
<p style="margin:0;color:#576c61;">If you did not ask to reset your password, you can ignore this email.</p>
