<% messages = object.errors.full_messages_for(name) %>
<div>
  <%= label_tag name, label %>
  <div class="password-control">
    <%= password_field_tag name, nil, required: true, minlength: 12, maxlength: 72, autocomplete: "new-password",
      aria: { invalid: messages.any? ? "true" : nil, describedby: ["password-requirements", messages.any? ? "#{name}-error" : nil].compact.join(" ") } %>
    <button type="button" class="button-secondary password-toggle" data-password-toggle="<%= name %>" data-password-label="<%= label.downcase %>" aria-controls="<%= name %>" aria-label="Show <%= label.downcase %>" aria-pressed="false" hidden>Show</button>
  </div>
  <% if messages.any? %><p class="field-error" id="<%= name %>-error"><%= messages.to_sentence %></p><% end %>
</div>
